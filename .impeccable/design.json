  "narrative": {
    "northStar": "Картотека клієнтів",
    "overview": "Compact white/gray records, navy actions, and small corners follow the app. Green/mint colors and spacious mobile rows were rejected.\n\nAuthority: effective workspace CSS/modules and `prototype.css` navy; `core/theme.js` fixes light mode. See `PRODUCT.md` and `docs/superpowers/specs/2026-10-14-admin-mobile-clarity-design.md`.",
    "keyCharacteristics": [
      "Three spaces: «Клієнти», «Матеріали», «Система».",
      "Mobile bottom navigation; desktop directory and inspector.",
      "Purchases, manual permissions, and legacy access stay distinct.",
      "Telegram device/content safe areas protect controls and records."
    ],
    "rules": [
      {
        "name": "The Safe Edges Rule",
        "body": "Telegram chrome and bottom navigation must leave the first control and final record reachable.",
        "section": "layout"
      },
      {
        "name": "The Evidence Rule",
        "body": "Visible access or a manual permission is never proof of payment; recorded sums never become current catalog prices.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve compact records, fixed light colors, bottom navigation, safe insets, wrapping, and focus.",
      "**Do** preserve honest evidence, manual product names, drafts, and pending locks."
    ],
    "donts": [
      "**Don't** restore green/mint colors, spacious rows, upper mobile destinations, or dark admin mode.",
      "**Don't** infer payment from access/prices or make a three-column text table or large card grid."
    ]
  }
